# Environnement upstream `github-mcp-server` officiel — DOCUMENTATION UNIQUEMENT.
# Fichier reel : /srv/github/secrets/upstream.env (0600, root:root ou github-app),
# cree sur le VPS par saisie securisee (jamais versionne, jamais dans Git).
# Aucun secret ici : noms uniquement.

# PAT GitHub dedie au MCP (lecture + ecriture, tous depots personnels).
# Saisie : lecture silencieuse depuis le terminal sur le VPS, jamais dans le chat.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Surface fonctionnelle maximale : tous les toolsets. Ne jamais activer read-only ici.
GITHUB_TOOLSETS=all

# Cle d'etat MRTR (base64 32 octets, stable) : requise pour exposer delete_repository.
# Generer sur le VPS : openssl rand -base64 32 | tr -d '\n'
GITHUB_MCP_SERVER_MRTR_STATE_KEY=

# Version upstream pinnee (ne pas suivre latest a l'aveugle).
# Image : ghcr.io/github/github-mcp-server:v1.12.0 (+ digest releve au pull)
# Digest valide le 2026-09-10 (linux/arm64, VPS etude) :
# sha256:46cdbbd810faf6f7aed1745ea04057443f5cb9fcadc15c7308add18cf9a83e33
UPSTREAM_IMAGE=ghcr.io/github/github-mcp-server:v1.12.0
