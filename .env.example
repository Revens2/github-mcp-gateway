# Variables d'environnement de la passerelle GitHub — DOCUMENTATION UNIQUEMENT.
# Le fichier réel (github.env, 0600, propriété du compte de service) est créé par
# deploy/install-gateway.sh ; jamais versionné.

# Port d'écoute de la passerelle (boucle locale ; nginx est le point d'entrée externe)
GITHUB_MCP_PORT=8799

# Issuer OAuth : URL HTTPS publique (exemple)
GITHUB_MCP_ISSUER=

# URL du serveur MCP upstream (github-mcp-server officiel en http, boucle locale)
GITHUB_MCP_UPSTREAM=http://127.0.0.1:8800

# Jeton Bearer statique pour les clients CLI + scopes
GITHUB_MCP_TOKEN=
GITHUB_MCP_TOKEN_SCOPES=github:lecture github:ecriture

# PAT GitHub interne : chemin du fichier dedie (0600, seul le token, sans retour
# chariot final de preference). La passerelle l'injecte en Bearer vers l'upstream
# (le mode http officiel exige un Authorization par requete) ; sans ce fichier,
# tout relais est refuse en fail-closed mais OAuth/discovery restent servis.
GITHUB_MCP_UPSTREAM_TOKEN_FILE=

# Empreinte PBKDF2 de la phrase de consentement OAuth
GITHUB_MCP_CONSENT_HASH=
